package testeCharts;

import java.io.FileWriter;
import java.io.IOException;
import java.util.List;

public class HtmlView {

    private List<Estatistica> estatisticas;

    public HtmlView(List<Estatistica> estatisticas) {
        this.estatisticas = estatisticas;
    }

    public String gerarRelatorio() {

        Estatistica est = estatisticas.get(0); // usando primeira lista

        StringBuilder dadosGrafico = new StringBuilder();
        dadosGrafico.append("['Produto', 'Preço'],\n");

        int contador = 1;
        for (double valor : est.getValores()) {
            dadosGrafico.append("['P" + contador + "', " + valor + "],\n");
            contador++;
        }

        String html =
                "<html>\n" +
                "<head>\n" +
                "<script type=\"text/javascript\" src=\"https://www.gstatic.com/charts/loader.js\"></script>\n" +
                "<script type=\"text/javascript\">\n" +
                "google.charts.load('current', {'packages':['corechart']});\n" +
                "google.charts.setOnLoadCallback(drawChart);\n" +
                "function drawChart() {\n" +
                "var data = google.visualization.arrayToDataTable([\n" +
                dadosGrafico.toString() +
                "]);\n" +
                "var options = {\n" +
                "title: 'Preços das Memórias RAM',\n" +
                "legend: { position: 'bottom' }\n" +
                "};\n" +
                "var chart = new google.visualization.LineChart(document.getElementById('curve_chart'));\n" +
                "chart.draw(data, options);\n" +
                "}\n" +
                "</script>\n" +
                "</head>\n" +
                "<body>\n" +
                "<div id=\"curve_chart\" style=\"width: 900px; height: 500px\"></div>\n" +
                "</body>\n" +
                "</html>";

        return html;
    }

    public void exportarHtml(String caminho) {
        try (FileWriter writer = new FileWriter(caminho)) {
            writer.write(gerarRelatorio());
            System.out.println("Arquivo HTML gerado com sucesso!");
        } catch (IOException e) {
            System.out.println("Erro ao gerar HTML: " + e.getMessage());
        }
    }
}