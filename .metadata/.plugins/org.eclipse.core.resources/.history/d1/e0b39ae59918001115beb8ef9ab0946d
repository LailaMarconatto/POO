    private static void gerarGraficoExtremos(StringBuilder html,
                                             List<Produto> produtos,
                                             boolean max,
                                             String divId,
                                             String titulo,
                                             List<String> ordemDDR) {

        Map<String, Map<String, Double>> mapa = produtos.stream()
                .filter(p -> p.getTipoDDR() != null && p.getCategoria() != null)
                .collect(Collectors.groupingBy(
                        Produto::getTipoDDR,
                        Collectors.groupingBy(
                                Produto::getCategoria,
                                Collectors.collectingAndThen(
                                        Collectors.mapping(Produto::getPreco, Collectors.toList()),
                                        lista -> {
                                            if (lista.isEmpty()) return 0.0;
                                            return max
                                                    ? lista.stream().max(Double::compare).orElse(0.0)
                                                    : lista.stream().min(Double::compare).orElse(0.0);
                                        }
                                )
                        )
                ));

        String varData = "data_" + divId;
        String varChart = "chart_" + divId;

        StringJoiner joinExtremos = new StringJoiner(",");

        for (String ddr : ordemDDR) {

            double pc = mapa.getOrDefault(ddr, new HashMap<>())
                            .getOrDefault("PC", 0.0);

            double note = mapa.getOrDefault(ddr, new HashMap<>())
                              .getOrDefault("Notebook", 0.0);

            joinExtremos.add(String.format(Locale.US,
                "['%s', {v: %.2f, f: formatMoney(%.2f)}, {v: %.2f, f: formatMoney(%.2f)}]",
                ddr, pc, pc, note, note
            ));
        }

        html.append("var " + varData + " = google.visualization.arrayToDataTable([");
        html.append("['TipoDDR', 'PC', 'Notebook'],");
        html.append(joinExtremos.toString());
        html.append("]);");

        html.append(
            "var " + varChart + " = new google.visualization.ColumnChart(document.getElementById('" + divId + "'));" +
            varChart + ".draw(" + varData + ", {" +
            "title: '" + titulo + "'," +
            "legend: { position: 'top' }," +
            "vAxis: { format: 'R$ #,##0.00' }" +
            "});"
        );
    }
